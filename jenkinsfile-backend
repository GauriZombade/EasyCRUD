pipeline {
    agent {
        label 'worker'
    }

    tools {
        maven 'maven'
    }

    environment {
        my_aws_cred = credentials('aws-cred')
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: 'main', url: 'https://github.com/mayurpandit25/EasyCRUD.git'
            }
        }

        stage('Build') {
            steps {
                dir('backend') {
                    sh '''
                        mvn clean package 
                    '''
                }
            }
            post {
                success {
                    archiveArtifacts artifacts: 'backend/target/*.jar', fingerprint: true
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                dir('backend') {
                    withSonarQubeEnv('sonar') {
                        sh 'mvn sonar:sonar'
                    }
                }
            }
        }

        stage('Quality gates') {
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Docker Build') {
            steps {
                sh '''
                    docker build -t backend .
                    docker images
                '''
            }
        }

        stage('Push Image To ECR') {
            steps {
                sh '''
                    aws ecr get-login-password --region us-east-2 | docker login --username AWS --password-stdin 942049393829.dkr.ecr.us-east-2.amazonaws.com
                    docker tag backend:latest 942049393829.dkr.ecr.us-east-2.amazonaws.com/backend:latest
                    docker push 942049393829.dkr.ecr.us-east-2.amazonaws.com/backend:latest
                '''
            }
        }
    }
}

