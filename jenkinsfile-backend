pipeline {
    agent {
        label 'worker'
    }

    tools{
        maven 'mvn'
    }

    environment {
        my_aws_cred = credentials('aws-access')
        ECR_REPO = '525382241025.dkr.ecr.us-west-2.amazonaws.com/backend'
    }

    stages {
        stage('Checkout'){
            steps {
                git branch: 'main', url: 'https://github.com/mayurpandit25/EasyCRUD.git'
            }
        }

        stage('Build'){
            steps {
                dir('backend'){
                    sh 'mvn clean package'
                }
            }
            post {
                success {
                    archiveArtifacts artifacts: 'backend/target/*.jar', fingerprint: true
                }
            }
        }

        stage('Artifact to S3') {
            steps {
                sh '''
                    sudo snap install aws-cli --classic
                    aws s3 cp backend/target/*.jar s3://mayurcbz.spacee/Artifact/student.war
                '''
            }
        }

        stage('SonarQube Analysis') {
            steps {
                dir('backend') {
                    withSonarQubeEnv('sonar') {
                        sh 'mvn sonar:sonar'
                    }
                }
            }
        }

        stage('Quality Gates') {
            steps {
                timeout(time: 5, unit: 'MINUTES'){
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Docker Build') {
            steps {
                dir('backend') {
                    sh '''
                        docker build -t backend:${BUILD_NUMBER} .
                        docker images
                    '''
                }
            }
        }

        stage('Push To ECR') {
            steps {
                sh '''
                    aws ecr get-login-password --region us-west-2 | docker login --username AWS --password-stdin 525382241025.dkr.ecr.us-west-2.amazonaws.com
                    docker tag backend:${BUILD_NUMBER} ${ECR_REPO}:${BUILD_NUMBER}
                    docker push ${ECR_REPO}:${BUILD_NUMBER}
                '''
            }
        }

        stage('Update Manifest') {
            steps {
                sh '''
                    sed -i "s|image: .*|image: ${ECR_REPO}:${BUILD_NUMBER}|" k8s/backend/backend-deployment.yaml
                '''
            }
        }

    }
}