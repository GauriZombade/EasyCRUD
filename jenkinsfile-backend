pipeline {
    agent {
        label 'worker'
    }

    tools{
        maven 'maven'
    }

    environment {
        my_aws_cred = credentials('aws-access')
        ECR_REPO = '673498377906.dkr.ecr.eu-north-1.amazonaws.com/backend'
    }

    stages {
        stage('Checkout'){
            steps {
                git branch: 'main', credentialsId:'github-cred', url: 'https://github.com/GauriZombade/EasyCRUD.git'
            }
        }

        stage('Build'){
            steps {
                dir('backend'){
                    sh 'mvn clean package'
                }
            }
            post {
                success {
                    archiveArtifacts artifacts: 'backend/target/*.jar', fingerprint: true
                }
            }
        }

        stage('Artifact to S3') {
            steps {
                sh '''
                    sudo snap install aws-cli --classic
                    aws s3 cp backend/target/*.jar s3://gaurdevops.space/Artifact/student.jar
                '''
            }
        }

        stage('SonarQube Analysis') {
            steps {
                dir('backend') {
                    withSonarQubeEnv('sonar') {
                        sh 'mvn sonar:sonar'
                    }
                }
            }
        }

        stage('Quality Gates') {
            steps {
                timeout(time: 5, unit: 'MINUTES'){
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Docker Build') {
            steps {
                dir('backend') {
                    sh '''
                        docker build -t backend:${BUILD_NUMBER} .
                        docker images
                    '''
                }
            }
        }
       stage('Approval') {
            steps {
                timeout(time: 30, unit: 'MINUTES') {
                    input message: 'Approve deployment to Kubernetes?', ok: 'Approve'
                }
            }
        }
        stage('Docker Push') {
          steps {
                sh '''
                    aws ecr get-login-password --region eu-north-1 | docker login --username AWS --password-stdin 673498377906.dkr.ecr.eu-north-1.amazonaws.com
                    docker tag backend:${BUILD_NUMBER} ${ECR_REPO}:${BUILD_NUMBER}
                    docker push ${ECR_REPO}:${BUILD_NUMBER}
                '''
            }
        }
        stage('Update Manifest') {
            steps {
                sh '''
                   sed -i "s|image: .*|image: ${ECR_REPO}:${BUILD_NUMBER}|" k8s/backend/backend-deployment.yaml

                '''
            }
        }
        
        stage('Push change to GITHUB') {
            steps{
                 withCredentials([
                    usernamePassword(
                        credentialsId: "github-cred",
                        usernameVariable: "GIT_USERNAME",
                        passwordVariable: "GIT_PASSWORD"
                    )
                ]){
                    sh '''
                      git config user.name "GauriZombade"
                        git config user.email "zombadegauri02@gmail.com"

                        git add k8s/backend/backend-deployment.yaml
                        git commit -m "Update backend-deployment"
                        git push https://${GIT_USERNAME}:${GIT_PASSWORD}@github.com/GauriZombade/EasyCRUD.git HEAD:main
                        '''

                }
            }
        }
        stage('Update Argocd deployment') {
            steps {
                sh '''
                    sudo aws eks update-kubeconfig --name cluster-1 --region eu-north-1
                    sudo kubectl apply -f argocd/backend-application.yaml
                    sudo kubectl get application -n argocd
                '''
            }
        }

    }


}
