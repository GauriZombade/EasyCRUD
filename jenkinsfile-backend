pipeline {
    agent {
        label 'worker'
    }

    tools {
        maven 'maven'
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: 'main', url: 'https://github.com/mayurpandit25/EasyCRUD.git'
            }
        }

        stage('Build') {
            steps {
                dir('backend') {
                    sh '''
                        mvn clean package 
                    '''
                }
            }
            post {
                success {
                    archiveArtifacts artifacts: 'backend/target/*.jar', fingerprint: true
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                dir('backend') {
                    withSonarQubeEnv('sonar') {
                        sh 'mvn sonar:sonar'
                    }
                }
            }
        }
    }
}

