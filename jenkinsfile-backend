pipeline {
    agent {
        label 'worker'
    }

    tools{
        maven 'mvn'
    }

    environment {
        my_aws_cred = credentials('aws-access')
    }

    stages {
        stage('Checkout'){
            steps {
                git branch: 'main', url: 'https://github.com/mayurpandit25/EasyCRUD.git'
            }
        }

        stage('Build'){
            steps {
                dir('backend'){
                    sh 'mvn clean package'
                }
            }
            post {
                success {
                    archiveArtifacts artifacts: 'backend/target/*.jar', fingerprint: true
                }
            }
        }

        stage('Artifact to S3') {
            steps {
                sh '''
                    sudo snap install aws-cli --classic
                    aws s3 cp backend/target/*.jar s3://mayurcbz.spacee/Artifact/student.war
                '''
            }
        }
    }
}