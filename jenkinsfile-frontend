pipeline {
    agent {
        label 'worker'
    }

    environment {
        my_aws_cred = credentials('aws-cred')
        ECR_REPO = '942049393829.dkr.ecr.us-east-2.amazonaws.com/frontend'
    }

    stages {
        stage('Checkout') {
            steps{
                git branch: 'main', credentialsId: 'github-cred-pat', url: 'https://github.com/mayurpandit25/EasyCRUD.git'
            }
        }

        stage('Build') {
            steps {
                dir('frontend') {
                    sh '''
                        npm install
                        npm run build
                    '''
                }
            }
            post {
                success {
                    archiveArtifacts artifacts: 'frontend/dist/**', fingerprint: true
                }
            }
        }

        stage('Docker Build') {
            steps {
                dir('frontend') {
                    sh '''
                        docker build -t frontend:${BUILD_NUMBER} .
                        docker images
                    '''
                }
            }
        }
        
        stage('Push Image to ECR') {
            steps {
                sh '''
                aws ecr get-login-password --region us-east-2 | docker login --username AWS --password-stdin 942049393829.dkr.ecr.us-east-2.amazonaws.com
                docker tag frontend:${BUILD_NUMBER} ${ECR_REPO}:${BUILD_NUMBER}
                docker push ${ECR_REPO}:${BUILD_NUMBER}
                '''
            }
        }

        stage('Update k8s Manifest') {
            steps {
                sh '''
                sed -i "s|image: .*|image: ${ECR_REPO}:${BUILD_NUMBER}|" k8s/frontend/frontend-deployment.yaml
                '''
            }
        }

        stage('Push Changes To GitHub') {
            steps {

                withCredentials([
                    usernamePassword(
                        credentialsId: 'github-cred-pat',
                        usernameVariable: 'GIT_USERNAME',
                        passwordVariable: 'GIT_PASSWORD'
                    )
                ]) {

                    sh '''
                        git config user.name "mayurpandit25"
                        git config user.email "panditmayur888@gmail.com"

                        git add k8s/frontend/frontend-deployment.yaml

                        git commit -m "Update frontend image to ${BUILD_NUMBER}" || true

                        git push https://${GIT_USERNAME}:${GIT_PASSWORD}@github.com/mayurpandit25/EasyCRUD.git HEAD:main
                    '''
                }
            }
        }
    }
}
