//frontend
pipeline {
    agent {
        label "worker"
    }

    environment {
        MY_AWS_CRED = credentials('aws-access')
        ECR_REPO = '673498377906.dkr.ecr.eu-north-1.amazonaws.com/frontend'
    }

    stages {
        stage('Checkout') {
            steps {
               git branch: 'main', credentialsId: 'github-cred', url: 'https://github.com/GauriZombade/EasyCRUD.git'

            }
        }

        stage('Build-frontend') {
            steps {
                dir('frontend') {
                    sh '''
                        npm install 
                        npm run build
                    '''
                }
            }
            post {
                success {
                    archiveArtifacts artifacts: 'frontend/dist/**', fingerprint: true
                }
            }
        }

        stage('Push artifacts to s3') {
            steps {
                sh '''
                    aws s3 sync frontend/dist s3://gaurdevops.space 
                '''
            }
        }

        stage('Docker Build') {
            steps {
                dir('frontend') {
                    sh '''
                    docker rmi -f $(docker images -q)
                    docker build -t frontend:${BUILD_NUMBER} .
                    docker images
                    '''
                }
            }
        }

        stage('Trivy Image scanning') {
            steps {
                sh '''
                    trivy image --scanners vuln --severity HIGH,CRITICAL --exit-code 0 frontend:${BUILD_NUMBER}
                '''
            }
        }

        stage('Approval') {
            steps {
                timeout(time: 30 , unit: "MINUTES") {
                    input message: 'Deployment to kubernetes?', ok: 'Approve'
                }
            }
        }

        stage('Push image to ECR') {
            steps {
                sh '''
                    aws ecr get-login-password --region eu-north-1 | docker login --username AWS --password-stdin 673498377906.dkr.ecr.eu-north-1.amazonaws.com
                    docker tag frontend:${BUILD_NUMBER} ${ECR_REPO}:${BUILD_NUMBER}
                    docker push ${ECR_REPO}:${BUILD_NUMBER}
                '''
            }
        }

        stage('Update Manifest') {
            steps {
                sh '''
                    sed -i "s|image: .*|image: ${ECR_REPO}:${BUILD_NUMBER}|" k8s/frontend/frontend-deployment.yaml
                '''
            }
        }

        stage("Push change to GITHUB"){
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: "github-cred",
                        usernameVariable: "GIT_USERNAME",
                        passwordVariable: "GIT_PASSWORD"
                    )
                ]) {

                    sh '''
                        git config user.name "GauriZombade"
                        git config user.email "zombadegauri02@gmail.com"

                        git add k8s/frontend/frontend-deployment.yaml
                        git commit -m "Update frontend-deployment"
                        git push https://${GIT_USERNAME}:${GIT_PASSWORD}@github.com/GauriZombade/EasyCRUD.git HEAD:main
                    '''
                }
            }
        }
        
       /* stage('Update Argocd deployment') {
            steps {
                sh '''
                    sudo aws eks update-kubeconfig --name my-eks-cluster1 --region eu-north-1
                    sudo kubectl apply -f argocd/frontend-application.yaml
                    sudo kubectl apply -f argocd/ingress-application.yaml
                    sudo kubectl get application -n argocd
                '''
            }
     }
     */
    }

    
    
}
            








