pipeline {
    agent {
        label "worker"
    }

    environment {
        MY_AWS_CRED = credentials('aws-access')
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: "main", credentialsId: "github-cred", url: "https://github.com/mayurpandit25/EasyCRUD.git"

            }
        }

        stage('Build-frontend') {
            steps {
                dir('frontend') {
                    sh '''
                        npm install 
                        npm run build
                    '''
                }
            }
            post {
                success {
                    archiveArtifacts artifacts: 'frontend/dist/**', fingerprint: true
                }
            }
        }

        stage('Push artifacts to s3') {
            steps {
                sh '''
                    aws s3 sync frontend/dist s3://mayurcbz.spacee
                '''
            }
        }
    }
}

