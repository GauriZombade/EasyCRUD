pipeline {
    agent {
        label "worker"
    }

    environment {
        MY_AWS_CRED = credentials('aws-access')
        ECR_REPO = "525382241025.dkr.ecr.us-west-2.amazonaws.com/frontend"
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: "main", credentialsId: "github-cred", url: "https://github.com/mayurpandit25/EasyCRUD.git"

            }
        }

        stage('Build-frontend') {
            steps {
                dir('frontend') {
                    sh '''
                        npm install 
                        npm run build
                    '''
                }
            }
            post {
                success {
                    archiveArtifacts artifacts: 'frontend/dist/**', fingerprint: true
                }
            }
        }

        stage('Push artifacts to s3') {
            steps {
                sh '''
                    aws s3 sync frontend/dist s3://mayurcbz.spacee
                '''
            }
        }

        stage('Docker Build') {
            steps {
                dir('frontend') {
                    sh '''
                    docker rmi -f $(docker images -q)
                    docker build -t frontend:${BUILD_NUMBER} .
                    docker images
                    '''
                }
            }
        }

        stage('Trivy Image scanning') {
            steps {
                sh '''
                    trivy image --scanners vuln --severity HIGH,CRITICAL --exit-code 0 frontend:${BUILD_NUMBER}
                '''
            }
        }

        stage('Approval') {
            steps {
                timeout(time: 30 , unit: "MINUTES") {
                    input message: 'Deployment to kubernetes?', ok: 'Approve'
                }
            }
        }

        stage('Push image to ECR') {
            steps {
                sh '''
                    aws ecr get-login-password --region us-west-2 | docker login --username AWS --password-stdin 525382241025.dkr.ecr.us-west-2.amazonaws.com
                    docker tag frontend:${BUILD_NUMBER} ${ECR_REPO}:${BUILD_NUMBER}
                    docker push ${ECR_REPO}:${BUILD_NUMBER}
                '''
            }
        }

        stage('Update Manifest') {
            steps {
                sh '''
                    sed -i "s|image: .*|image: ${ECR_REPO}:${BUILD_NUMBER}|" k8s/frontend/frontend-deployment.yaml
                '''
            }
        }

        stage("Push change to GITHUB"){
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: "github-cred",
                        usernameVariable: "GIT_USERNAME",
                        passwordVariable: "GIT_PASSWORD"
                    )
                ]) {

                    sh '''
                        git config user.name "mayurpandit25"
                        git config user.email "panditmayur888@gmail.com"

                        git add k8s/frontend/frontend-deployment.yaml
                        git commit -m "Update frontend-deployment"
                        git push https://${GIT_USERNAME}:${GIT_PASSWORD}@github.com/mayurpandit25/EasyCRUD.git HEAD:main
                    '''
                }
            }
        }
    }

    post {
        success {
            cleanWs()
        }
    }
}








