pipeline {
    agent {
        label 'worker'
    }

    environment {
        my_aws_cred = credentials('aws-cred')
    }

    stages {
        stage('Checkout') {
            steps{
                git branch: 'main', credentialsId: 'github-cred-pat', url: 'https://github.com/mayurpandit25/EasyCRUD.git'
            }
        }

        stage('Build') {
            steps {
                sh '''
                    npm install
                    npm run build
                '''
            }
            post {
                success {
                    archiveArtifacts artifacts: 'frontend/dist/**', fingerprint: true
                }
            }
        }
    }
}
